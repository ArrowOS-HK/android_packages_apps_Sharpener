<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/sharpener_quicksettings_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <PreferenceCategory
        android:key="invqs_panel_category"
        android:title="@string/qs_invqs_category_title">

        <com.arrow.support.preferences.SystemSettingSwitchPreference
            android:key="qs_invqs_enabled"
            android:title="@string/qs_invqs_enabled_title"
            android:summary="@string/qs_invqs_enabled_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="invqs_custom_controls_category"
        android:title="@string/qs_invqs_custom_controls_category"
        android:dependency="qs_invqs_enabled">

        <androidx.preference.EditTextPreference
            android:key="invos_qs_custom_username"
            android:title="@string/invos_qs_custom_username_title"
            android:persistent="false" />

        <androidx.preference.EditTextPreference
            android:key="invos_qs_custom_subtitle"
            android:title="@string/invos_qs_custom_subtitle_title"
            android:persistent="false" />

        <Preference
            android:key="invos_qs_custom_image_select"
            android:title="@string/invos_qs_custom_image_select_title"
            android:summary="@string/invos_qs_custom_image_select_summary"
            android:persistent="false" />

        <Preference
            android:key="invos_qs_custom_image_clear"
            android:title="@string/invos_qs_custom_image_clear_title"
            android:persistent="false" />

        <com.arrow.support.preferences.SystemSettingSwitchPreference
            android:key="invos_qs_custom_gif_animate"
            android:title="@string/invos_qs_custom_gif_animate_title"
            android:summary="@string/invos_qs_custom_gif_animate_summary"
            android:defaultValue="false" />

        <com.arrow.support.preferences.SystemSettingSeekBarPreference
            android:key="invos_qs_custom_image_alpha"
            android:title="@string/invos_qs_custom_image_alpha_title"
            settings:min="0"
            android:max="255"
            android:defaultValue="255" />

    </PreferenceCategory>

    <com.arrow.support.preferences.SecureSettingSwitchPreference
        android:key="qs_show_data_usage"
        android:title="@string/qs_show_data_usage_title"
        android:summary="@string/qs_show_data_usage_summary"
        android:defaultValue="true" />

    <PreferenceCategory
        android:key="quick_settings_battery_category"
        android:title="@string/status_bar_battery_category_title">

        <com.arrow.support.preferences.SystemSettingListPreference
            android:key="qs_battery_style"
            android:title="@string/status_bar_battery_style_title"
            android:entries="@array/qs_battery_style_entries"
            android:entryValues="@array/qs_battery_style_values"
            android:defaultValue="-1" />

        <com.arrow.support.preferences.SystemSettingListPreference
            android:key="qs_show_battery_percent"
            android:title="@string/status_bar_battery_percent_title"
            android:entries="@array/status_bar_battery_percent_entries"
            android:entryValues="@array/status_bar_battery_percent_values"
            android:defaultValue="2" />

    </PreferenceCategory>

	<PreferenceCategory
        android:key="quick_settings_brighness_category"
        android:title="@string/qs_show_brightness_slider_title">

        <com.arrow.support.preferences.SecureSettingListPreference
            android:key="qs_show_brightness_slider"
            android:title="@string/qs_show_brightness_slider_title"
            android:entries="@array/qs_show_brightness_slider_entries"
            android:entryValues="@array/qs_show_brightness_slider_values"
            android:defaultValue="1" />

        <com.arrow.support.preferences.SecureSettingListPreference
            android:key="qs_brightness_slider_position"
            android:title="@string/qs_brightness_slider_position_title"
            android:entries="@array/qs_brightness_slider_position_entries"
            android:entryValues="@array/qs_brightness_slider_position_values"
            android:defaultValue="0" />

        <com.arrow.support.preferences.SecureSettingSwitchPreference
            android:key="qs_show_auto_brightness"
            android:title="@string/qs_show_auto_brightness_title"
            android:summary="@string/qs_show_auto_brightness_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="quick_settings_tile_category"
        android:title="@string/qs_tiles_category_title">

        <com.arrow.support.preferences.SecureSettingListPreference
            android:key="qs_style_round"
            android:title="@string/qs_style_title"
            android:entries="@array/qs_style_entries"
            android:entryValues="@array/qs_style_values"
            android:defaultValue="0" />

        <com.arrow.support.preferences.SecureSettingListPreference
            android:key="qs_tile_shape"
            android:title="@string/qs_tile_shape"
            android:entries="@array/qs_tile_shape_entries"
            android:entryValues="@array/qs_tile_shape_values"
            android:defaultValue="2" />

        <com.arrow.support.preferences.SecureSettingSeekBarPreference
            android:key="qqs_num_columns"
            android:title="@string/qqs_columns"
            settings:min="2"
            android:max="5"
            android:defaultValue="5" />

        <com.arrow.support.preferences.SecureSettingSeekBarPreference
            android:key="qqs_num_columns_landscape"
            android:title="@string/qqs_columns_landscape"
            settings:min="2"
            android:max="6"
            android:defaultValue="6" />

        <com.arrow.support.preferences.SecureSettingSeekBarPreference
            android:key="qs_num_columns"
            android:title="@string/qs_columns"
            settings:min="2"
            android:max="4"
            android:defaultValue="4" />

        <com.arrow.support.preferences.SecureSettingSeekBarPreference
            android:key="qs_num_columns_landscape"
            android:title="@string/qs_columns_landscape"
            settings:min="2"
            android:max="6"
            android:defaultValue="6" />    

    </PreferenceCategory>

</PreferenceScreen>
